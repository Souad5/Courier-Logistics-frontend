# Base URL of the B7A6 courier-backend API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Stripe publishable key (pk_test_...). Payments use Stripe Checkout redirects
# created by the backend, so this is only needed for future Stripe.js features.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
